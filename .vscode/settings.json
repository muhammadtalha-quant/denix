{
    "nix.enableLanguageServer": true,
    "nix.formatterPath": "nixfmt",
    "nix.serverPath": "nixd",
    "nix.serverSettings": {
        "formatting": {
            "command": [ "nixfmt" ]
        },
        "options": {
            "nixos": {
                "expr": "(builtins.getFlake (builtins.toString ./.).nixosConfigurations.hp-probook-430g2.options",
            },
            "home-manager": {
                "expr": "(builtins.getFlake (builtins.toString ./.).nixosConfigurations.hp-probook-430g2.options.home-manager.users.type.getSubOptions []",
            }
        }
    }
}